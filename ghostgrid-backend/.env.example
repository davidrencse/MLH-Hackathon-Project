HOST=127.0.0.1
PORT=3001
GHOSTGRID_DATA_DIR=data
# Optional explicit frontend origin allowlist; a same-origin dev proxy also works.
GHOSTGRID_ALLOWED_ORIGINS=
GHOSTGRID_CONCURRENCY=4
GHOSTGRID_PROVIDER_CONCURRENCY=2
GHOSTGRID_TASK_TIMEOUT_MS=300000
GHOSTGRID_MAX_ATTEMPTS=3

# Set these explicitly when needed. Do not commit credential values.
# GHOSTGRID_API_TOKEN=
# GHOSTGRID_DATABASE_PATH=data/ghostgrid.sqlite
# GHOSTGRID_ALLOWED_WORKSPACES=/absolute/path/to/trusted/repository
# GHOSTGRID_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Groq model discovery uses https://api.groq.com/openai/v1/models
# GROQ_API_KEY=
