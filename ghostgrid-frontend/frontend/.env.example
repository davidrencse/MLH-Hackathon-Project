# Ghost Grid frontend → ghostgrid-backend
#
# Copy to .env.local. Every value is optional: with no .env.local the app probes
# the backend through the Vite proxy (/gg → http://127.0.0.1:3001) and silently
# falls back to the mock backend when it is not running.

# Where the backend is. Default "/gg" uses the dev proxy in vite.config.ts.
# Use an absolute URL for a deployed backend, e.g. https://ghostgrid.example.com
# (that backend then needs GHOSTGRID_ALLOWED_ORIGINS set to this frontend's origin).
# VITE_GG_API_URL=/gg

# Required only when the backend runs with GHOSTGRID_API_TOKEN set.
# VITE_GG_API_TOKEN=

# Attach to a specific backend project. Otherwise the first project is used,
# or "Ghost Grid City" is created.
# VITE_GG_PROJECT_ID=

# 1 = always use the backend, 0 = always use the mock. Unset = probe /health.
# VITE_GG_LIVE=

# Library of Babel read-only bridge (ghostgrid-backend/LIBRARY.md).
# VITE_GG_LIBRARY_URL=http://127.0.0.1:8765

# Hosted Library of Babel web app opened when the Library building is clicked.
# Defaults to VITE_GG_LIBRARY_URL, then http://127.0.0.1:8765.
# VITE_GG_LIBRARY_SITE_URL=http://127.0.0.1:8765
